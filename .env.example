# ---- Admin login (set these in Vercel → Project → Settings → Environment Variables) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie (e.g. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=

# ---- Firebase / Firestore (Firebase console → Project settings → Service accounts → Generate new private key) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line with literal \n sequences, wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL=https://techsolv.vercel.app
