{
  "name": "techsolv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node --experimental-strip-types --env-file=.env.local scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/unit.test.ts",
    "test:smoke": "node --env-file-if-exists=.env.local tests/smoke.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.18",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
